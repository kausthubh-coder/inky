{
  "name": "studi-2",
  "productName": "Studi",
  "version": "0.1.0",
  "description": "A local-first schoolwork desktop agent for the Studi private beta.",
  "author": "Studi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron . --studi-development-url=http://127.0.0.1:5173\"",
    "start": "npm run build && electron .",
    "start:fresh": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-StudiFresh.ps1",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && esbuild ./electron/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.cjs --sourcemap",
    "package:win": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && npm run test:contracts && npm run test:packaging && npm run test:foundation",
    "test:contracts": "npm run build:electron && node --test \"tests/contracts/*.test.mjs\"",
    "test:agent": "npm run build:electron && node --test \"tests/agent/*.test.mjs\"",
    "test:auth": "npm run build:electron && node --test \"tests/auth/*.test.mjs\"",
    "test:telemetry": "npm run build:electron && node --test \"tests/telemetry/*.test.mjs\"",
    "test:packaging": "npm run build:electron && node --test \"tests/packaging/*.test.mjs\"",
    "test:storage": "npm run build:electron && node --test \"tests/storage/*.test.mjs\"",
    "test:foundation": "node --test tests/clean-room-boundary.test.mjs tests/build-shape.test.mjs",
    "preview": "vite preview",
    "test:electron": "npm run build && node tests/electron-self-test-runner.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "convex": "^1.45.0",
    "electron-squirrel-startup": "^1.0.1",
    "jose": "^6.1.0",
    "posthog-node": "^5.51.6",
    "typebox": "1.3.7",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@fontsource/nunito-sans": "^5.2.8",
    "@fontsource/shantell-sans": "^5.2.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "esbuild": "0.25.12",
    "fast-check": "4.9.0",
    "posthog-js": "^1.424.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.25.12": true
  }
}
