{
  "name": "studi-2",
  "productName": "Studi",
  "version": "0.1.1",
  "description": "A local-first schoolwork desktop agent for the Studi private beta.",
  "author": "Studi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "landing"
  ],
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "preview:ui": "vite --host 127.0.0.1 --port 4174 --strictPort --open /?preview=gallery",
    "dev:electron": "bun run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron . --studi-development-url=http://127.0.0.1:5173\"",
    "dev:landing": "bun run --filter landing dev",
    "start": "bun run build && electron .",
    "start:fresh": "bun run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-StudiFresh.ps1",
    "build": "bun run build:electron && vite build",
    "build:electron": "tsc -p desktop/electron/tsconfig.json && bun scripts/copy-agent-packs.mjs && esbuild ./desktop/electron/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.cjs --sourcemap",
    "build:landing": "bun run --filter landing build",
    "package:win": "bun run build && electron-forge package --platform=win32 --arch=x64",
    "make:win": "bun run build && electron-forge make --platform=win32 --arch=x64",
    "package:mac": "bun run build && electron-forge package --platform=darwin --arch=universal",
    "make:mac": "bun run build && electron-forge make --platform=darwin --arch=universal",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p desktop/electron/tsconfig.json --noEmit",
    "test": "bun run typecheck && bun run build && bun run test:contracts && bun run test:packaging && bun run test:foundation",
    "test:contracts": "bun run build:electron && node --test \"tests/contracts/*.test.mjs\"",
    "test:agent": "bun run build:electron && node --test \"tests/agent/*.test.mjs\"",
    "test:auth": "bun run build:electron && node --test \"tests/auth/*.test.mjs\"",
    "test:telemetry": "bun run build:electron && node --experimental-strip-types --test \"tests/telemetry/*.test.mjs\"",
    "test:packaging": "bun run build:electron && node --test \"tests/packaging/*.test.mjs\"",
    "test:storage": "bun run build:electron && node --test \"tests/storage/*.test.mjs\"",
    "test:foundation": "node --test tests/clean-room-boundary.test.mjs tests/build-shape.test.mjs",
    "preview": "vite preview",
    "test:electron": "bun run build && node tests/electron-self-test-runner.mjs",
    "agent:harness": "bun agent-harness/cli.ts",
    "test:harness": "bun run agent:harness -- run --suite foundation --driver scripted --json && bun run agent:harness -- run --suite routing --driver scripted --json && bun run agent:harness -- run --suite trace --driver scripted --json && bun run agent:harness -- run --suite files --driver scripted --json",
    "test:composio": "bun scripts/composio-test.ts",
    "deploy:composio-policy": "bun scripts/deploy-composio-policy.ts",
    "test:all": "bun run typecheck && bun run build && bun run test:contracts && bun run test:agent && bun run test:storage && bun run test:auth && bun run test:telemetry && bun run test:packaging && bun run test:foundation && bun run test:harness && bun run test:electron"
  },
  "dependencies": {
    "@composio/core": "^0.18.0",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "convex": "^1.45.0",
    "electron-squirrel-startup": "^1.0.1",
    "jose": "^6.1.0",
    "posthog-node": "^5.51.6",
    "typebox": "1.3.7",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron/universal": "^3.0.6",
    "@fontsource/nunito-sans": "^5.2.8",
    "@fontsource/shantell-sans": "^5.2.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "esbuild": "0.25.12",
    "fast-check": "4.9.0",
    "posthog-js": "^1.424.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "wait-on": "^8.0.4",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.25.12": true
  }
}
