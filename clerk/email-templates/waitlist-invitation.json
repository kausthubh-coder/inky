{
  "name": "Waitlist invitation",
  "subject": "Your free Inky beta seat is ready ✦",
  "markup": "<re-html><re-head><re-title>Your free Inky beta seat is ready</re-title></re-head><re-body background-color=\"#f6efe3\" padding=\"44px 20px\"><re-preheader>The door is open. Come meet Inky.</re-preheader><re-main background-color=\"#fffaf0\" border-radius=\"20px\"><re-block padding=\"28px 30px 12px\" background-color=\"#b9e8ff\" border-radius=\"20px 20px 0px 0px\"><re-text font-size=\"13px\" font-weight=\"bold\" color=\"#1c1612\">A NOTE FROM INKY</re-text><re-heading level=\"h1\" font-size=\"30px\" line-height=\"36px\" color=\"#1c1612\" margin=\"8px 0px 0px\">Okay. I’m ready when you are.</re-heading></re-block><re-block padding=\"26px 30px 30px\" background-color=\"#fffaf0\" border-radius=\"0px 0px 20px 20px\"><re-text font-size=\"16px\" line-height=\"25px\" color=\"#1c1612\">Your private-beta seat is open. I can scan your schoolwork every day (or whenever you ask), finish it, save the answers for you, and only submit when you tell me to.</re-text><re-block padding=\"15px 18px\" margin=\"20px 0px 0px\" background-color=\"#dff6e8\" border-radius=\"12px\"><re-text font-size=\"14px\" line-height=\"22px\" color=\"#1c1612\"><strong>Still free.</strong> You won’t be asked for a card.</re-text></re-block><re-button href=\"{{action_url}}\" background-color=\"#1c1612\" color=\"#ffffff\" border-radius=\"999px\" font-size=\"15px\" font-weight=\"bold\" padding=\"13px 22px\" margin=\"24px 0px 0px\">Meet Inky</re-button><re-text font-size=\"13px\" line-height=\"20px\" color=\"#857a72\" margin=\"16px 0px 0px\">This invitation expires in {{invitation.expires_in_days}} days. If the button is being dramatic, use this link: <a href=\"{{action_url}}\" style=\"color:#1c1612;text-decoration:underline\">open my seat</a>.</re-text><re-text font-size=\"14px\" line-height=\"22px\" color=\"#5f554e\" margin=\"22px 0px 0px\">See you inside.<br>— Inky ✎</re-text></re-block></re-main><re-footer padding=\"22px 8px\"><re-text align=\"center\" font-size=\"12px\" color=\"#857a72\">You got this because you joined Inky’s waitlist.</re-text></re-footer></re-body></re-html>",
  "body": "<!doctype html><html><body style=\"margin:0;background:#f6efe3;font-family:Arial,sans-serif;color:#1c1612\"><div style=\"display:none\">The door is open. Come meet Inky.</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:44px 20px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:100%;background:#fffaf0;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 30px;background:#b9e8ff\"><div style=\"font-size:13px;font-weight:bold\">A NOTE FROM INKY</div><h1 style=\"margin:8px 0 0;font-size:30px;line-height:36px\">Okay. I’m ready when you are.</h1></td></tr><tr><td style=\"padding:26px 30px 30px\"><p style=\"font-size:16px;line-height:25px\">Your private-beta seat is open. I can scan your schoolwork every day (or whenever you ask), finish it, save the answers for you, and only submit when you tell me to.</p><p style=\"padding:15px 18px;background:#dff6e8;border-radius:12px;font-size:14px;line-height:22px\"><strong>Still free.</strong> You won’t be asked for a card.</p><p><a href=\"{{action_url}}\" style=\"display:inline-block;padding:13px 22px;background:#1c1612;color:#fff;border-radius:999px;text-decoration:none;font-size:15px;font-weight:bold\">Meet Inky</a></p><p style=\"font-size:13px;line-height:20px;color:#857a72\">This invitation expires in {{invitation.expires_in_days}} days. If the button is being dramatic, <a href=\"{{action_url}}\" style=\"color:#1c1612\">open my seat</a>.</p><p style=\"font-size:14px;line-height:22px;color:#5f554e\">See you inside.<br>— Inky ✎</p></td></tr></table><p style=\"font-size:12px;color:#857a72\">You got this because you joined Inky’s waitlist.</p></td></tr></table></body></html>"
}
