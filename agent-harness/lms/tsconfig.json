{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM"],
    "types": ["node", "react"], "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
